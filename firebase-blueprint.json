{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "chats": {
      "title": "Chat Session",
      "description": "Stores chat session metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "mode": { "type": "string" },
        "title": { "type": "string" },
        "messageCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "mode", "title"]
    },
    "messages": {
      "title": "Message",
      "description": "Stores individual messages within a chat.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "file"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document."
    },
    "/chats/{chatId}": {
      "schema": "chats",
      "description": "Chat session document."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "messages",
      "description": "Individual message document."
    }
  }
}
