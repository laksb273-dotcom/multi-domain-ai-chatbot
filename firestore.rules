rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isChatOwner(chatId) {
      return isAuthenticated() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidString(field, min, max) {
      return request.resource.data[field] is string && 
             request.resource.data[field].size() >= min && 
             request.resource.data[field].size() <= max;
    }

    function isRecent(field) {
      return request.resource.data[field] is timestamp &&
             request.resource.data[field] <= request.time &&
             request.resource.data[field] >= request.time - duration.value(5, 'm');
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "laksb273@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['uid', 'email', 'displayName']) &&
             hasOnlyAllowedFields(['uid', 'email', 'displayName', 'createdAt', 'role']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.displayName is string && data.displayName.size() > 0;
    }

    function isValidChat(data) {
      return hasRequiredFields(['userId', 'mode', 'title', 'messageCount', 'updatedAt']) &&
             hasOnlyAllowedFields(['userId', 'mode', 'title', 'messageCount', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.messageCount is number && data.messageCount >= 0 && data.messageCount <= 20;
    }

    function isValidMessage(data) {
      return hasRequiredFields(['role', 'content', 'type', 'timestamp']) &&
             hasOnlyAllowedFields(['role', 'content', 'type', 'timestamp']) &&
             data.role in ['user', 'model'] &&
             data.type in ['text', 'image', 'file'] &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 10000;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.role == resource.data.role;
    }

    // Chat Sessions
    match /chats/{chatId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidChat(request.resource.data);
      allow update: if isDocOwner() && isValidChat(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isDocOwner() || isAdmin();
      
      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isChatOwner(chatId) || isAdmin();
        allow create: if isChatOwner(chatId) && isValidMessage(request.resource.data);
      }
    }
  }
}
